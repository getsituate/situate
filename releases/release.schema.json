{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Situate finalized release",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "baseline",
    "revision",
    "locales",
    "sourceApproval",
    "localeHashes",
    "finalDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "baseline": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "locales": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "sourceApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "sourceHash"],
      "properties": {
        "action": {
          "const": "approve"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "localeHashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "finalDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
