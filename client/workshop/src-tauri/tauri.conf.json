{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Situate Design Workshop",
  "version": "0.1.0",
  "identifier": "dev.situate.design-workshop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "capabilities": [
        {
          "identifier": "design-workshop",
          "description": "Design Workshop window events and controls.",
          "windows": ["design-controls", "design-preview"],
          "permissions": [
            "core:event:allow-listen",
            "core:event:allow-unlisten",
            "core:event:allow-emit-to",
            "core:window:allow-inner-size"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
