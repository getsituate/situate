{
  "name": "situate",
  "version": "0.1.6",
  "private": true,
  "volta": {
    "extends": "../package.json"
  },
  "type": "module",
  "workspaces": [
    "app",
    "workshop",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @situate/client -- --port 0",
    "design": "npm run design --workspace @situate/workshop",
    "build:design": "npm run build --workspace @situate/workshop",
    "dev:client": "node scripts/desktop-dev.mjs",
    "ios:xcode": "node scripts/ios-xcode.mjs",
    "build": "npm run build --workspace @situate/client",
    "build:client": "npm run tauri --workspace @situate/client -- build --no-bundle",
    "tauri": "npm run tauri --workspace @situate/client --",
    "release": "node scripts/release.mjs",
    "release:docker": "node scripts/release-docker.mjs",
    "release:apple": "node scripts/apple-release.mjs",
    "release:apple:upload": "node scripts/apple-upload.mjs",
    "check:localization": "node scripts/localization-check.mjs",
    "check": "npm run check --workspace @situate/client && cargo fmt --all -- --check && cargo clippy --workspace --all-targets --locked -- -D warnings",
    "test": "npm run test:scripts && npm run test --workspace @situate/client && cargo test --workspace --locked",
    "test:scripts": "node --test scripts/*.test.mjs",
    "test:docker-context": "node scripts/test-docker-context.mjs",
    "test:core": "cargo test -p situate-core --locked",
    "test:executor": "node ../tools/run-coordinated.mjs -- node ../tools/run-coordinated.mjs --resource build -- npm run test --workspace @situate/client -- --config vitest.integration.config.ts --allowOnly=false",
    "test:native": "node scripts/test-native.mjs",
    "test:agent": "node scripts/test-agent-e2e.mjs",
    "test:agent:live": "node scripts/test-agent-e2e.mjs --provider openai",
    "test:browser": "playwright test --config app/playwright.config.ts",
    "test:visual": "node ../tools/visual-tests.mjs",
    "test:visual:update": "node ../tools/visual-tests.mjs --update",
    "test:visual:report": "playwright show-report test-results/visual-report",
    "test:design": "npm run test --workspace @situate/workshop",
    "test:browser:design": "npm run test:browser --workspace @situate/workshop",
    "screenshots:workspaces": "node scripts/screenshot-workspaces.mjs",
    "screenshots:design": "node scripts/screenshot-workspaces.mjs --all",
    "screenshot:native": "node scripts/screenshot-native.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "24.19.0",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/coverage-v8": "5.0.3",
    "@vue/compiler-dom": "3.5.43",
    "@vue/compiler-sfc": "3.5.43",
    "@vue/test-utils": "2.5.1",
    "jsdom": "30.1.1",
    "postcss": "8.5.28",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.11"
  }
}
