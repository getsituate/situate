{
  "userAgent": "pi (browser)",
  "modelHeaders": ["user-agent", "nvcf-poll-seconds"],
  "apis": {
    "openai-completions": { "suffix": "/chat/completions", "headers": {} },
    "openai-responses": { "suffix": "/responses", "headers": {} },
    "openai-codex-responses": {
      "suffix": "/codex/responses",
      "headers": {},
      "nativeHeaders": {
        "openai-beta": "responses=experimental",
        "originator": "pi"
      },
      "nativeCredentialHeaders": ["authorization", "chatgpt-account-id"],
      "transport": "sse"
    },
    "anthropic-messages": {
      "suffix": "/v1/messages?beta=true",
      "headers": {
        "anthropic-version": ["2023-06-01"],
        "anthropic-beta": [
          "fine-grained-tool-streaming-2025-05-14",
          "interleaved-thinking-2025-05-14",
          "server-side-fallback-2026-07-01",
          "mid-conversation-output-config-2026-07-01",
          "thinking-binding-controls-2026-08-01",
          "inline-tools-2026-09-15"
        ]
      }
    }
  }
}
