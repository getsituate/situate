{
  "name": "@situate/client",
  "version": "0.1.6",
  "private": true,
  "volta": {
    "extends": "../../package.json"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node ../scripts/ai-catalog.mjs",
    "build": "node ../scripts/localization-check.mjs && vue-tsc --noEmit && vite build",
    "postbuild": "node ../scripts/bundle-report.mjs",
    "check": "node ../scripts/localization-check.mjs && vue-tsc --noEmit",
    "test": "vitest run",
    "tauri": "tauri"
  },
  "dependencies": {
    "@situate/localization": "0.0.0",
    "@situate/ui": "0.0.0",
    "@tauri-apps/api": "2.12.3",
    "es-module-lexer": "2.3.2",
    "js-tokens": "10.0.0",
    "markstream-vue": "2.0.21",
    "vue": "3.5.43"
  }
}
