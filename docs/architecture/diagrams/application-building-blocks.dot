digraph ApplicationBuildingBlocks {
  graph [rankdir=TB, bgcolor="#fffefa", pad=0.3, nodesep=0.45, ranksep=0.6, fontname="Helvetica", fontsize=14, fontcolor="#30203e"];
  node [shape=box, style="rounded,filled", fillcolor="#f6f3ee", color="#6a5c70", fontcolor="#30203e", fontname="Helvetica", fontsize=15, margin="0.2,0.14", penwidth=1.2];
  edge [color="#6a5c70", fontcolor="#30203e", fontname="Helvetica", fontsize=12, arrowsize=0.75];

  subgraph cluster_app {
    label="Situate Application — logical components";
    color="#6a5c70";
    style="rounded";
    margin=20;
    ui [label="User Interface", fillcolor="#eee7f9"];
    agent [label="Agent Integration"];
    runtime [label="Plugin Runtime"];
    core [label="Application Core", fillcolor="#eee7f9"];

    { rank=same; ui; agent; runtime; }
    ui -> core [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD>Workspace Lifecycle<BR/>Workspace Storage &amp; History<BR/>Platform Access</TD></TR></TABLE>>];
    agent -> core [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD>Workspace Lifecycle<BR/>Workspace Storage &amp; History<BR/>Platform Access</TD></TR></TABLE>>];
    runtime -> core [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD>Workspace Lifecycle<BR/>Workspace Storage &amp; History<BR/>Platform Access</TD></TR></TABLE>>];
    core -> runtime [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD>Sync Transport<BR/>(custom plugin)</TD></TR></TABLE>>, style=dashed];
  }
}
