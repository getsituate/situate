digraph UiViewHost {
  graph [rankdir=TB, bgcolor="#fffefa", pad=0.3, nodesep=0.45, ranksep=0.6, fontname="Helvetica", fontsize=14, fontcolor="#30203e"];
  node [shape=box, style="rounded,filled", fillcolor="#f6f3ee", color="#6a5c70", fontcolor="#30203e", fontname="Helvetica", fontsize=15, margin="0.2,0.14", penwidth=1.2];
  edge [color="#6a5c70", fontcolor="#30203e", fontname="Helvetica", fontsize=12, arrowsize=0.75];

  subgraph cluster_ui {
    label="User Interface — rendering and registration\nLevel 3 · accepted target";
    color="#6a5c70";
    style="rounded";
    margin=20;
    shell [label="Application Shell"];
    renderer [label="Layout Renderer\nand View Host", fillcolor="#eee7f9", color="#6232bc"];
    contributions [label="UI Contributions"];
    layout [label="Tab and Layout State"];
    navigation [label="Pane Navigation"];
    registry [label="View Registry\nand Sessions"];

    { rank=same; renderer; contributions; }
    { rank=same; layout; navigation; registry; }

    shell -> renderer [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD>Compose surface</TD></TR></TABLE>>];
    renderer -> layout [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD>Read layout</TD></TR></TABLE>>];
    renderer -> navigation [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD>Read active targets</TD></TR></TABLE>>];
    renderer -> registry [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD>Resolve / mount / release</TD></TR></TABLE>>];
    contributions -> registry [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD>Register views</TD></TR></TABLE>>];
  }
}
