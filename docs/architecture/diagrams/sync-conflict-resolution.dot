digraph SyncConflictResolution {
  graph [rankdir=TB, bgcolor="#fffefa", pad=0.3, nodesep=0.45, ranksep=0.6, fontname="Helvetica", fontsize=14, fontcolor="#30203e"];
  node [shape=box, style="rounded,filled", fillcolor="#f6f3ee", color="#6a5c70", fontcolor="#30203e", fontname="Helvetica", fontsize=15, margin="0.2,0.14", penwidth=1.2];
  edge [color="#6a5c70", fontcolor="#30203e", fontname="Helvetica", fontsize=12, arrowsize=0.75];

  changes [label="Reconcile local and received history\nApplication Core owns decisions"];
  usable [label="Repository usable?", shape=diamond];
  damaged [label="Report damaged history\nUse confirmed recovery flow"];
  divergent [label="Plugin source diverges\nunder same version?", shape=diamond];
  select [label="User selects one source revision\nRetain the other in history"];
  merge [label="Resolve Git merge conflicts\nSee conflict-resolution detail"];
  resume [label="Resume synchronization\nAfter all blocking conflicts resolve", fillcolor="#eee7f9", color="#6232bc"];

  changes -> usable;
  usable -> damaged [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD>No</TD></TR></TABLE>>];
  usable -> divergent [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD>Yes</TD></TR></TABLE>>];
  divergent -> select [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD>Yes: never auto-combine</TD></TR></TABLE>>];
  divergent -> merge [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD>No</TD></TR></TABLE>>];
  select -> merge [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD>Check remaining conflicts</TD></TR></TABLE>>];
  merge -> resume;
}
