digraph WorkspaceCompatibility {
  graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.5, fontname="Helvetica", fontsize=12];
  node [shape=box, style="rounded,filled", fillcolor="#f5f7fa", color="#536171", fontname="Helvetica", fontsize=13, margin="0.18,0.12"];
  edge [color="#536171", fontname="Helvetica", fontsize=11, arrowsize=0.8];

  metadata [label="Read compatibility metadata\ninside .situate"];
  gate [label="App version >=\nminimumAppVersion?", shape=diamond];
  blocked [label="Keep workspace closed\nRequest an app update", fillcolor="#fbe9e7"];
  position [label="Compare lastAppliedMigration\nwith the app's ordered registry"];
  pending [label="Run pending migrations\nbefore opening"];
  unchanged [label="No migration\nPreserve the recorded position"];
  open [label="Open the workspace core\nCheck plugins separately", fillcolor="#e5effa"];

  metadata -> gate;
  gate -> blocked [label="No"];
  gate -> position [label="Yes"];
  position -> pending [label="Known earlier ID"];
  position -> unchanged [label="Current or valid later ID"];
  pending -> open [label="Migration and cleanup succeed"];
  unchanged -> open;
}
