@startuml
hide footbox
skinparam shadowing false
skinparam backgroundColor #fffefa
skinparam defaultFontName Helvetica
skinparam defaultFontSize 14
skinparam defaultFontColor #30203e
skinparam roundcorner 12
skinparam sequenceMessageAlign left
skinparam maxMessageSize 165
skinparam BoxPadding 10
skinparam sequence {
  ArrowColor #6a5c70
  ArrowFontColor #30203e
  ArrowFontSize 13
  LifeLineBorderColor #8c7a97
  ParticipantBorderColor #6a5c70
  ParticipantBackgroundColor #eee7f9
  ParticipantFontColor #30203e
  ActorBorderColor #6a5c70
  ActorBackgroundColor #fffefa
  ActorFontColor #30203e
  GroupBorderColor #6a5c70
  GroupBackgroundColor #f6f3ee
  GroupHeaderFontColor #30203e
  DividerBorderColor #8c7a97
  DividerBackgroundColor #f6f3ee
}
skinparam note {
  BackgroundColor #fff7e3
  BorderColor #8c7a97
  FontColor #30203e
  FontSize 12
}

actor User
participant "User Interface" as UI
participant "Action owner\nAgent / manual" as Owner
participant "Application Core" as Core
participant "Plugin" as Plugin
participant "External provider" as External

User -> UI: Request work / invoke export
UI -> Owner: Submit stable action identity
Owner -> Owner: Validate scope, capabilities\nand cancellation

== Durable intent ==
Owner -> Core: Persist intent
Core --> Owner: Durable acknowledgement

== Execute within requested scope ==
Owner -> Plugin: Invoke tool or export
activate Plugin
Plugin -> External: Execute scoped request
External --> Plugin: Result, failure or uncertainty
Plugin --> Owner: Observed outcome
deactivate Plugin

== Durable outcome ==
Owner -> Owner: Drain owned operations
Owner -> Core: Persist result and completion
Core --> Owner: Durable acknowledgement
Owner --> UI: Outcome / manual receipt
UI --> User: Display result

note over Owner, Core
  Save retry repeats persistence, not execution.
  Cancellation does not undo prior effects.
  Uncertain outcomes are not replayed automatically.
end note
@enduml
