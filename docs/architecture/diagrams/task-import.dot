digraph TaskImport {
  graph [rankdir=TB, bgcolor="#fffefa", pad=0.3, nodesep=0.45, ranksep=0.6, fontname="Helvetica", fontsize=14, fontcolor="#30203e"];
  node [shape=box, style="rounded,filled", fillcolor="#f6f3ee", color="#6a5c70", fontcolor="#30203e", fontname="Helvetica", fontsize=15, margin="0.2,0.14", penwidth=1.2];
  edge [color="#6a5c70", fontcolor="#30203e", fontname="Helvetica", fontsize=12, arrowsize=0.75];

  source [label="User describes source"];
  agree [label="Agree task recognition\nand field meanings"];
  importer [label="Agent develops importer\nWithin available access"];
  convert [label="Prepare Markdown copies\nPreserve content and metadata"];
  identity [label="Assign fresh task UUIDs\nNo embedded file IDs"];
  publish [label="Publish imported files\nSources remain unchanged", fillcolor="#eee7f9", color="#6232bc"];

  source -> agree;
  agree -> importer;
  importer -> convert;
  convert -> identity;
  identity -> publish [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD>Shared file operations</TD></TR></TABLE>>];
}
