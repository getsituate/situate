{
  "name": "situate-quality",
  "private": true,
  "volta": {
    "node": "24.21.0",
    "npm": "11.19.1"
  },
  "type": "commonjs",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier . --check",
    "format": "prettier . --write",
    "quality:swift": "node tools/quality.mjs swift",
    "quality:kotlin": "node tools/quality.mjs kotlin",
    "quality:rust": "node tools/quality.mjs rust",
    "quality:secrets": "node tools/quality.mjs secrets",
    "quality:audit": "node tools/quality.mjs audit",
    "test:quality": "node --test tools/quality.test.mjs"
  },
  "overrides": {
    "@earendil-works/pi-coding-agent": {
      "undici": "8.12.3",
      "minimatch": "11.0.8"
    },
    "minimatch@10": "11.0.8"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vue-eslint-parser": "10.4.1"
  }
